<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Sift.MainWindow" Title="Sift" Background="#11151B" Foreground="#E9EDF2" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Width="680" Height="860" MinWidth="540" MinHeight="650" Icon="sift.ico" WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="Signal" Text="Preparado para escuchar" Foreground="#A7B5C4"/>
                        <TextBlock x:Name="LevelText" Text="−∞ dBFS" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ProgressBar x:Name="Meter" Minimum="0" Maximum="100" Height="6" Margin="0,10,0,10" Foreground="#74D8C5" Background="#303A46" BorderThickness="0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SESIÓN" FontSize="10" Foreground="#A7B5C4"/>
                            <TextBlock x:Name="Elapsed" Text="00:00:00" FontSize="18"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="SavedLabel" Text="AUDIO GUARDADO" FontSize="10" Foreground="#A7B5C4"/>
                            <TextBlock x:Name="Saved" Text="00:00:00" FontSize="18"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Button x:Name="Record" Content="●  Grabar" Background="#79DDC5" Foreground="#10251F" FontWeight="SemiBold" FontSize="17" Padding="18,12" Click="RecordClick"/>
            <TextBlock x:Name="Message" Foreground="#B9C5D2" Margin="0,12,0,0"/>
            <Border x:Name="ResultPanel" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="ResultText" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="▷  Reproducir" Padding="10,6" FontSize="12" Click="PlayClick"/>
                        <Button Content="Abrir carpeta" Padding="10,6" FontSize="12" Click="OpenClick" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="sift.png" Width="40" Height="40" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Sift" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="El sonido que eliges." Foreground="#A7B5C4" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#243C39" CornerRadius="12" Padding="12,6">
                        <TextBlock x:Name="Status" Text="Listo" Foreground="#85E4CD"/>
                    </Border>
                </Grid>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="APLICACIÓN" Style="{StaticResource Label}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="↻" FontSize="20" Margin="10,0,0,0" Click="RefreshClick" ToolTip="Actualizar aplicaciones" x:Name="Refresh"/>
                            <ComboBox x:Name="Apps" AutomationProperties.Name="Aplicación que quieres grabar">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Pid}"/>
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0"/>
                                            <StackPanel MaxWidth="370">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Context}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Activity}" Foreground="#287B64" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Text="Captura el proceso y sus hijos. Las ventanas o pestañas que comparten proceso pueden compartir audio." FontSize="11" Foreground="#91A0B1" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="OutputControls">
                        <TextBlock Text="SALIDA" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="Format" SelectedIndex="0">
                                <ComboBoxItem Content="FLAC"/>
                                <ComboBoxItem Content="WAV"/>
                            </ComboBox>
                            <ComboBox x:Name="Mode" Grid.Column="1" Margin="12,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="Archivo único"/>
                                <ComboBoxItem Content="Archivos separados"/>
                            </ComboBox>
                        </Grid>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Examinar…" Click="BrowseClick" Margin="10,0,0,0"/>
                            <TextBox x:Name="Folder" AutomationProperties.Name="Carpeta de destino"/>
                        </DockPanel>
                        <TextBlock Text="PCM 24 bits · 48 kHz · estéreo · sin efectos" FontSize="11" Foreground="#91A0B1" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="DetectionControls">
                        <TextBlock Text="GRABACIÓN INTELIGENTE" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="Skip" Content="Omitir silencios" IsChecked="True"/>
                        <CheckBox x:Name="Trim" Content="Recortar silencios iniciales y finales" IsChecked="True"/>
                        <CheckBox x:Name="Brief" Content="Eliminar sonidos muy breves en los extremos" ToolTip="Opcional. También puede descartar sonidos breves legítimos."/>
                        <Expander Header="Parámetros de detección">
                            <Grid Margin="4,12,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Umbral de entrada (−90 a −6 dBFS)"/>
                                <TextBox x:Name="Threshold" Grid.Column="1" Text="-45"/>
                                <TextBlock Grid.Row="1" Text="Espera de silencio (200–10000 ms)"/>
                                <TextBox x:Name="Silence" Grid.Row="1" Grid.Column="1" Text="1500"/>
                                <TextBlock Grid.Row="2" Text="Audio previo (0–1000 ms)"/>
                                <TextBox x:Name="Pre" Grid.Row="2" Grid.Column="1" Text="200"/>
                                <TextBlock Grid.Row="3" Text="Audio posterior (0–2000 ms)"/>
                                <TextBox x:Name="Post" Grid.Row="3" Grid.Column="1" Text="200"/>
                                <TextBlock Grid.Row="4" Text="Duración mínima (0–1000 ms)"/>
                                <TextBox x:Name="Minimum" Grid.Row="4" Grid.Column="1" Text="80"/>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
